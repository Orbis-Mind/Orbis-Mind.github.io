---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  title={`${post.data.title} · Orbis Mind`}
  description={post.data.description}
  active="blog"
  ogType="article"
>
  <article class="article">
    <div class="wrap">
      <div class="article-head">
        <div class="kick">
          <a href={`${base}/blog`}>← Blog</a>
          <span class="sep" style="color:var(--faint)">/</span>
          <span class="tag">{post.data.tag}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
        <div class="byline">
          <div class="avatar">
            <svg width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="8.5" fill="none" stroke="currentColor" stroke-width="2"></circle><ellipse cx="16" cy="16" rx="12.2" ry="5.1" fill="none" stroke="var(--accent)" stroke-width="1.6" transform="rotate(-28 16 16)"></ellipse><circle cx="26.2" cy="10.8" r="2.5" fill="var(--accent)"></circle></svg>
          </div>
          <div class="who"><b>{post.data.author}</b> <span>· {fmt(post.data.date)} · {post.data.readingTime ?? 'Article'}</span></div>
        </div>
      </div>

      <div class="prose">
        <Content />
      </div>

      <div class="article-foot">
        <a class="btn btn-ghost" href={`${base}/blog`}>← All posts</a>
        <a class="btn btn-ghost" href="https://github.com/Orbis-Mind/aether" target="_blank" rel="noopener">Explore the code ↗</a>
      </div>
    </div>
  </article>
</Base>
