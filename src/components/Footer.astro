---
import BrandMark from './BrandMark.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="wrap">
    <!-- top CTA + newsletter -->
    <div class="foot-cta">
      <div class="foot-cta-in">
        <div>
          <h3>Build on infrastructure you can audit.</h3>
          <p>Occasional notes on compilers, runtimes, and reliable AI systems. No spam, unsubscribe anytime.</p>
        </div>
        <form class="newsletter" action={`${base}/blog`} method="get" aria-label="Newsletter signup">
          <input type="email" name="email" placeholder="you@company.com" aria-label="Email address" />
          <button class="btn btn-primary" type="submit">Subscribe</button>
        </form>
      </div>
    </div>

    <!-- link columns -->
    <div class="foot-main">
      <div class="foot-brandcol">
        <a class="brand" href={`${base}/`}>
          <BrandMark size={24} />
          <span class="word">Orbis<b>·</b>Mind</span>
        </a>
        <p class="about">Building the infrastructure layer for intelligent software — open-source compilers and runtimes for AI workloads.</p>
        <div class="socials">
          <a href="https://github.com/Orbis-Mind" target="_blank" rel="noopener" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"></path></svg>
          </a>
          <a href="https://github.com/Orbis-Mind/aether" target="_blank" rel="noopener" aria-label="Aether repository">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 7v6c0 4 3 6 7 8 4-2 7-4 7-8V7l-7-4Z"></path></svg>
          </a>
          <a href={`${base}/rss.xml`} aria-label="RSS feed">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1.4" fill="currentColor"></circle></svg>
          </a>
        </div>
      </div>

      <div>
        <h5>Projects</h5>
        <a href={`${base}/aether`}>Aether</a>
        <a href={`${base}/optiflow`}>OptiFlow</a>
        <a href={`${base}/docs`}>Documentation</a>
      </div>
      <div>
        <h5>Resources</h5>
        <a href={`${base}/blog`}>Blog</a>
        <a href={`${base}/docs#roadmap`}>Roadmap</a>
        <a href={`${base}/aether#benchmarks`}>Benchmarks</a>
        <a href={`${base}/aether#cli`}>CLI reference</a>
      </div>
      <div>
        <h5>Source</h5>
        <a href="https://github.com/Orbis-Mind" target="_blank" rel="noopener">GitHub org ↗</a>
        <a href="https://github.com/Orbis-Mind/aether" target="_blank" rel="noopener">aether ↗</a>
        <a href="https://github.com/Orbis-Mind/optiflow" target="_blank" rel="noopener">optiflow ↗</a>
      </div>
      <div>
        <h5>Company</h5>
        <a href={`${base}/#principles`}>Principles</a>
        <a href={`${base}/#projects`}>Live projects</a>
        <a href="https://github.com/Orbis-Mind" target="_blank" rel="noopener">Contribute ↗</a>
      </div>
    </div>

    <div class="foot-bottom">
      <span class="mono">© {year} Orbis Mind · MIT Licensed</span>
      <span class="foot-status mono"><span class="dot"></span> All systems operational</span>
      <div class="legal mono">
        <a href={`${base}/`}>Home</a>
        <a href="https://github.com/Orbis-Mind/aether/blob/main/LICENSE" target="_blank" rel="noopener">License</a>
        <a href={`${base}/rss.xml`}>RSS</a>
      </div>
    </div>
  </div>
</footer>
