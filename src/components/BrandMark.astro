---
interface Props { size?: number; class?: string }
const { size = 26, class: cls = '' } = Astro.props;
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="8.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
  <ellipse cx="16" cy="16" rx="12.2" ry="5.1" fill="none" stroke="var(--accent)" stroke-width="1.6" transform="rotate(-28 16 16)"></ellipse>
  <circle cx="26.2" cy="10.8" r="2.5" fill="var(--accent)"></circle>
</svg>
